generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

view bods_user {
  id                Int                     @id @default(1)
  username          String                  @unique
  email             String                  @unique
  first_name        String?
  last_name         String?
  password          String
  is_superuser      Boolean
  is_active         Boolean
  userOrganisations bods_userorganisation[]
  account_type Int?
  admin_org    Int?
  created_by_alerts Alert[]            @relation("created_by_user")
  send_to_alerts    Alert[]            @relation("send_to_user")
}

view bods_userorganisation {
  user            bods_user         @relation(fields: [user_id], references: [id])
  user_id         Int
  organisation    bods_organisation @relation(fields: [organisation_id], references: [id])
  organisation_id Int

  @@id([user_id, organisation_id])
}

view bods_organisation {
  id                     Int                         @id @default(1)
  name                   String
  is_abods_global_viewer Boolean
  userOrganisations      bods_userorganisation[]
  operatorOrganisations  bods_organisationoperator[]
}

view all_operators {
  operatorid            Int?
  operatorref           String                      @id
  name                  String
  operatorOrganisations bods_organisationoperator[]
  noc_adminareas noc_adminarea[]
}

view bods_organisationoperator {
  organisation    bods_organisation @relation(fields: [organisation_id], references: [id])
  organisation_id Int
  operatorref     String
  operator        all_operators     @relation(fields: [operatorref], references: [operatorref])

  @@id([organisation_id, operatorref])
}

model Alert {
  id               String     @id @default(uuid())
  alert            String? //type
  event_hysterisis Int?
  event_threshold  Int?
  created_by_user  bods_user? @relation(fields: [created_by], references: [id], name: "created_by_user")
  created_by       Int?
  send_to_user     bods_user? @relation(fields: [send_to], references: [id], name: "send_to_user")
  send_to          Int?
}

model Role {
  id    Int    @id @default(1)
  name  String
  scope String
}

model ApiInfo {
  id              String       @id @default("1")
  build_number    String
  version         String
  timezone        String
  feature_flag    FeatureFlag? @relation(fields: [feature_flag_id], references: [id])
  feature_flag_id String?      @unique
}

model FeatureFlag {
  id                              String   @id @default("1")
  consolidate_histogram           Boolean  @default(false)
  corridor_stats_timezone_enabled Boolean  @default(false)
  freshdesk_enabled               Boolean  @default(false)
  line_direction_filtering        Boolean  @default(false)
  sso_enabled                     Boolean  @default(false)
  stop_index_filtering            Boolean  @default(false)
  tagging_include_bank_holidays   Boolean  @default(false)
  vehicle_replay_from_timestream  Boolean  @default(false)
  apiinfo                         ApiInfo?
}

model Tokens {
  user_id Int    @unique
  token   String
}

model aa_timetable_summary_noc {
  timetable_id    Int   @id @default(1)
	operator_noc String
	date_of_journey DateTime
	day_of_week Int
	departure_hour DateTime? @db.Time(6)
	is_timing_point Boolean
	on_time_count Int
	early_count Int
	late_count Int
	completed Int
	scheduled Int
	max_late Int
	max_early Int
  avg_time_difference Int
}

model aa_timetable_summary_soc {
  timetable_id    Int   @id @default(1)
  common_name String
	operator_noc String
  service_code String
	date_of_journey DateTime
	day_of_week Int
	departure_hour DateTime? @db.Time(6)
	is_timing_point Boolean
	on_time_count Int
	early_count Int
	late_count Int
	completed Int
	scheduled Int
	max_late Int
	max_early Int
  avg_time_difference Int
}

model aa_timetable_summary_stops {
  timetable_id    Int   @id @default(1)
	operator_noc String
  service_code String
  stop_id Int
  stop_latitude           Decimal?
  stop_longitude          Decimal?
  locality_id             String?
  common_name             String?
	date_of_journey DateTime
	day_of_week Int
	departure_hour DateTime? @db.Time(6)
	is_timing_point Boolean
	on_time_count Int
	early_count Int
	late_count Int
	completed Int
	scheduled Int
	max_late Int
	max_early Int
  avg_time_difference Int
}

model Timetable {
  timetable_id            Int      @id @default(1)
  operator_noc            String?
  operator_name           String?
  service_code            String?
  line_name               String?
  xml_file_name           String?
  journey_code            String?
  date_of_journey         DateTime?
  day_of_week             Int
  common_name             String?
  atco_code               String?
  stop_type               String?
  stop_index              Int?
  stop_latitude           Decimal?
  stop_longitude          Decimal?
  locality_id             String?
  expected_departure_time DateTime? @db.Time(6)
  actual_departure_time   DateTime? @db.Time(6)
  is_timing_point         Boolean?
  group_id                String?
  previous_group_id       String?
  otp_state               String?
  expected_headway        Int?
  actual_headway          Int?
  headway_time_difference Int?
  siri_vm_position_id     Int?
  time_difference         Int?
  stop_id                 Int?
}

view naptan_adminarea_with_shape{
  id Int @id @default(1)
  name String
  atco_code String
  st_asgeojson String
  noc_adminareas noc_adminarea[]
}

view noc_adminarea {
  national_operator_code String
  adminarea_id Int

  admin_area    naptan_adminarea_with_shape @relation(fields: [adminarea_id], references: [id])
  operator      all_operators     @relation(fields: [national_operator_code], references: [operatorref])

  @@id([national_operator_code, adminarea_id])
}

model OperatorAdminArea {
  operator_admin_area_id Int    @id @default(1)
  operator_noc           String
  admin_area_id          Int
}

model ExpectedOperators {
  expected_operator_id Int                @id @default(1)
  noc                  String
  organization_id      Int
  operator_name        String
}

