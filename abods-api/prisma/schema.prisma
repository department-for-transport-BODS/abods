generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views", "strictUndefinedChecks"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src"
  fileName = "kysely.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model service_details {
  noc_and_line_and_servicecode String         @id
  operator_noc                 String?
  line_name                    String?
  service_name                 String?
  operator                     all_operators? @relation(fields: [operator_noc], references: [operatorref])

  @@index([line_name], map: "expected_services_line_name")
  @@index([operator_noc], map: "expected_services_operator_noc")
}

model Alert {
  id               String     @id @default(uuid()) @db.VarChar(100)
  alert_id         String?    @db.VarChar(100)
  alert            String?    @db.VarChar(100)
  event_hysterisis Decimal?   @db.Decimal(10, 0)
  event_threshold  Decimal?   @db.Decimal(10, 0)
  send_to          Int?
  created_by       Int?
  created_by_user  bods_user? @relation("created_by_user", fields: [created_by], references: [id])
  send_to_user     bods_user? @relation("send_to_user", fields: [send_to], references: [id])
}

model Role {
  id    Int    @id(map: "Role_pkey01")
  name  String @db.VarChar(100)
  scope String @db.VarChar(100)
}

model ApiInfo {
  id              String      @id @db.VarChar(100)
  version         String
  build_number    String
  timezone        String
  feature_flag_id String      @db.VarChar(100)
  feature_flag    FeatureFlag @relation(fields: [feature_flag_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "RefFeatureFlag12")
}

model FeatureFlag {
  id                              String    @id @db.VarChar(100)
  consolidate_histogram           Boolean
  corridor_stats_timezone_enabled Boolean
  freshdesk_enabled               Boolean
  line_direction_filtering        Boolean
  sso_enabled                     Boolean
  stop_index_filtering            Boolean
  tagging_include_bank_holidays   Boolean
  vehicle_replay_from_timestream  Boolean
  journey_insights_enabled        Boolean
  ApiInfo                         ApiInfo[]
}

model Tokens {
  user_id Int       @id
  token   String?   @db.VarChar(150)
  user    bods_user @relation(fields: [user_id], references: [id])
}

model SiriVMPositions {
  siri_vm_positions_id BigInt    @default(autoincrement())
  operator_ref         String
  line_name            String
  journey_ref          String
  direction_ref        String?
  date_of_journey      DateTime  @db.Date
  latitude             Float?    @db.Real
  longitude            Float?    @db.Real
  vehicle_ref          String
  batch_id             BigInt?
  recorded_at_time     DateTime  @db.Timestamptz(6)
  response_time_stamp  DateTime? @db.Timestamptz(6)
  load_time_stamp      DateTime? @default(now()) @db.Timestamptz(6)
  group_id             String?
  origin_ref           String?
  destination_ref      String?
  departure_time       DateTime? @db.Timestamptz(6)

  @@id([operator_ref, line_name, journey_ref, date_of_journey, vehicle_ref, recorded_at_time], map: "siri_positions_vehicleref_recordedattime_30052024")
  @@index([group_id], map: "siri_index_in_group_id")
}

model Timetable {
  timetable_id             BigInt                   @default(autoincrement())
  operator_noc             String
  operator_name            String
  service_code             String
  line_name                String?
  xml_file_name            String?
  journey_code             String?
  date_of_journey          DateTime                 @db.Date
  day_of_week              Int?
  common_name              String?
  atco_code                String?
  stop_type                String?
  stop_index               Int // TODO: fix - nullable in db
  stop_latitude            Float?                   @db.Real
  stop_longitude           Float?                   @db.Real
  locality_id              String?
  expected_departure_time  DateTime?                @db.Timestamptz(6)
  actual_departure_time    DateTime?                @db.Timestamptz(6)
  is_timing_point          Boolean?
  group_id                 String?
  previous_group_id        String?
  otp_state                String?
  expected_headway         Int?
  actual_headway           Int?
  headway_time_difference  Int?
  siri_vm_position_id      BigInt?
  time_difference          Int?
  stop_id                  Int // TODO: fix - nullable bigint in db
  load_time_stamp          DateTime?                @default(now()) @db.Timestamp(6)
  off_set                  Int?
  servicepattern_id        Int?
  vehiclejourney_id        Int?
  admin_area_id            Int?
  timestamp_after_estimate DateTime?                @db.Timestamptz(6)
  direction                String?
  departure_day_shift      Boolean?
  stops                    naptan_stoppoint_latlong @relation(fields: [stop_id], references: [id])

  @@id([timetable_id, date_of_journey], map: "timetable_pk_240603")
  @@index([operator_noc, line_name, journey_code], map: "compound_index_on_operator_noc_line_name_journey_code")
  @@index([is_timing_point], map: "index_on_is_timing_point")
  @@index([stop_id], map: "index_on_stop_id")
  @@index([vehiclejourney_id], map: "index_on_vehiclejourney_id")
  @@index([group_id], map: "timetable_index_in_group_id")
}

model expected_operators {
  date_of_journey   DateTime            @db.Date // TODO: fix - nullable in db
  operator_noc      String // TODO: fix - nullable in db
  operator_name     String?
  expected_services expected_services[]

  @@id([operator_noc, date_of_journey]) // TODO: fix - not in db
  @@index([date_of_journey], map: "expected_operators_v2_date_of_journey_idx")
  @@index([operator_noc], map: "expected_operators_v2_operator_noc_idx")
}

model expected_journeys {
  date_of_journey              DateTime           @db.Date // TODO: fix - nullable in db
  operator_noc                 String?
  line_name                    String?
  noc_and_line_and_servicecode String // TODO: fix - nullable in db
  journey_code                 String // TODO: fix - nullable in db
  group_id                     String // TODO: fix - nullable in db
  stop_count                   Int?
  expected_journey_start       DateTime?          @db.Timestamptz(6)
  journey_pattern_description  String // TODO: fix - nullable in db
  vehicle_journey_id           Int?
  day_of_week                  Int?
  admin_area_id                Int[]
  expected_journey_end         DateTime?          @db.Timestamptz(6)
  direction                    String?            @db.VarChar(20)
  expected_services            expected_services? @relation(fields: [noc_and_line_and_servicecode, date_of_journey], references: [noc_and_line_and_servicecode, date_of_journey])

  @@id([noc_and_line_and_servicecode, journey_code, date_of_journey]) // TODO: fix - not in db
  @@index([date_of_journey], map: "expected_journeys_v2_date_of_journey_idx")
  @@index([group_id], map: "expected_journeys_v2_group_id_idx")
  @@index([noc_and_line_and_servicecode], map: "expected_journeys_v2_noc_and_line_idx")
  @@index([operator_noc, line_name, journey_code], map: "expected_journeys_v2_operator_noc_line_name_journey_code_idx")
}

model transmodel_vehiclejourney {
  id                  BigInt    @id
  start_time          DateTime? @db.Time(6)
  direction           String?
  journey_code        String?
  line_ref            String?
  departure_day_shift Boolean
  service_pattern_id  Int?
  block_number        String?

  @@index([service_pattern_id])
}

model transmodel_servicepatternstop {
  id                 BigInt                   @id
  sequence_number    Int
  atco_code          String
  naptan_stop_id     Int // TODO: fix - nullable in db
  service_pattern_id Int
  departure_time     DateTime?                @db.Time(6)
  is_timing_point    Boolean
  txc_common_name    String?
  vehicle_journey_id Int?
  stop_activity_id   Int?
  naptan_stop        naptan_stoppoint_latlong @relation(fields: [naptan_stop_id], references: [id])

  @@index([naptan_stop_id])
  @@index([service_pattern_id])
  @@index([vehicle_journey_id])
}

model naptan_locality {
  gazetteer_id  String                     @id
  name          String
  easting       Int
  northing      Int
  admin_area_id BigInt // TODO: fix - nullable int in db
  district_id   Int?
  admin_area    naptan_adminarea           @relation(fields: [admin_area_id], references: [id]) // TODO: fix - not in db
  stops         naptan_stoppoint_latlong[]

  @@index([admin_area_id])
  @@index([district_id])
  @@index([gazetteer_id])
}

model naptan_adminarea {
  id                  BigInt            @id
  name                String
  traveline_region_id String
  atco_code           String
  ui_lta_id           Int?
  naptan_locality     naptan_locality[] // TODO: fix - not in db

  @@index([atco_code])
}

model timetable_threshold_summary {
  threshold_id                 BigInt    @id @default(autoincrement()) // TODO: fix - not id in db
  operator_noc                 String?
  line_name                    String?
  noc_and_line_and_servicecode String?
  service_name                 String?
  date_of_journey              DateTime? @db.Date
  is_timing_point              Boolean?
  time_diff_minutes            Float?
  departure_hour               DateTime? @db.Time(6)
  admin_areas                  Int[]
  otp_count                    Int? // TODO: fix - bigint in db
  day_of_week                  Int?
  estimated                    Boolean?  @default(false)
  departure_hour_only          DateTime  @db.Timetz(6)

  @@index([date_of_journey, operator_noc], map: "noc_index_timetable_threshold_summary")
  @@index([date_of_journey, time_diff_minutes], map: "timediff_index_timetable_threshold_summary")
}

