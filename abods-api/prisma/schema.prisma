generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-1.0.x"]
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

view bods_user {
  id                Int                     @id @default(1)
  username          String                  @unique
  email             String                  @unique
  first_name        String?
  last_name         String?
  password          String
  is_superuser      Boolean
  is_active         Boolean
  userOrganisations bods_userorganisation[]
  account_type Int?
  admin_org    Int?
  created_by_alerts Alert[]            @relation("created_by_user")
  send_to_alerts    Alert[]            @relation("send_to_user")
}

view bods_userorganisation {
  user            bods_user         @relation(fields: [user_id], references: [id])
  user_id         Int
  organisation    bods_organisation @relation(fields: [organisation_id], references: [id])
  organisation_id Int

  @@id([user_id, organisation_id])
}

view bods_organisation {
  id                     Int                         @id @default(1)
  name                   String
  is_abods_global_viewer Boolean
  userOrganisations      bods_userorganisation[]
  operatorOrganisations  bods_organisationoperator[]
}

view all_operators {
  operatorid            Int?
  operatorref           String                      @id
  name                  String
  operatorOrganisations bods_organisationoperator[]
  noc_adminareas noc_adminarea[]
}

view bods_organisationoperator {
  organisation    bods_organisation @relation(fields: [organisation_id], references: [id])
  organisation_id Int
  operatorref     String
  operator        all_operators     @relation(fields: [operatorref], references: [operatorref])

  @@id([organisation_id, operatorref])
}

model Alert {
  id               String     @id @default(uuid())
  alert            String? //type
  event_hysterisis Int?
  event_threshold  Int?
  created_by_user  bods_user? @relation(fields: [created_by], references: [id], name: "created_by_user")
  created_by       Int?
  send_to_user     bods_user? @relation(fields: [send_to], references: [id], name: "send_to_user")
  send_to          Int?
}

model Role {
  id    Int    @id @default(1)
  name  String
  scope String
}

model ApiInfo {
  id              String       @id @default("1")
  build_number    String
  version         String
  timezone        String
  feature_flag    FeatureFlag? @relation(fields: [feature_flag_id], references: [id])
  feature_flag_id String?      @unique
}

model FeatureFlag {
  id                              String   @id @default("1")
  consolidate_histogram           Boolean  @default(false)
  corridor_stats_timezone_enabled Boolean  @default(false)
  freshdesk_enabled               Boolean  @default(false)
  line_direction_filtering        Boolean  @default(false)
  sso_enabled                     Boolean  @default(false)
  stop_index_filtering            Boolean  @default(false)
  tagging_include_bank_holidays   Boolean  @default(false)
  vehicle_replay_from_timestream  Boolean  @default(false)
  apiinfo                         ApiInfo?
}

model Tokens {
  user_id Int    @unique
  token   String
}

model timetable_summary_operator {
  timetable_id    Int   @id @default(1)
	operator_noc String
	date_of_journey DateTime
	day_of_week Int
	departure_hour DateTime? @db.Time(6)
	is_timing_point Boolean
	on_time_count Int
	early_count Int
	late_count Int
	completed Int
	scheduled Int
	max_late Int
	max_early Int
  avg_time_difference Int
}

model timetable_summary_service {
  timetable_id    Int   @id @default(1)
  line_name String
  noc_and_line_and_servicecode String
  service_name String
	operator_noc String
	date_of_journey DateTime
	day_of_week Int
	departure_hour DateTime? @db.Time(6)
	is_timing_point Boolean
	on_time_count Int
	early_count Int
	late_count Int
	completed Int
	scheduled Int
	max_late Int
	max_early Int
  avg_time_difference Int
}

model timetable_summary_stops {
  timetable_id    Int   @id @default(1)
	operator_noc String
  service_code String
  noc_and_line_and_servicecode String
  stop_id Int
  stop_latitude           Decimal?
  stop_longitude          Decimal?
  locality_id             String
  common_name             String?
	date_of_journey DateTime
	day_of_week Int
	departure_hour DateTime? @db.Time(6)
	is_timing_point Boolean
	on_time_count Int
	early_count Int
	late_count Int
	completed Int
	scheduled Int
	max_late Int
	max_early Int
  avg_time_difference Int
  locality                naptan_locality @relation(fields: [locality_id], references: [gazetteer_id])
}

model SiriVMPositions{
  siri_vm_positions_id     Int      @id @default(1)
  operator_ref            String
  line_name               String
  journey_ref             String
  date_of_journey         DateTime
  latitude                Decimal
  longitude               Decimal
  vehicle_ref             String
  recorded_at_time        DateTime
  group_id                String
  Timetable               Timetable? 
  @@unique([group_id, recorded_at_time])
}


model Timetable {
  timetable_id            Int      @id @default(1)
  operator_noc            String?
  operator_name           String?
  service_code            String?
  line_name               String?
  xml_file_name           String?
  journey_code            String?
  date_of_journey         DateTime
  day_of_week             Int
  common_name             String?
  atco_code               String?
  stop_type               String?
  stop_index              Int
  stop_latitude           Decimal?
  stop_longitude          Decimal?
  locality_id             String?
  expected_departure_time DateTime?         @db.Timestamptz()
  actual_departure_time   DateTime?         @db.Timestamptz()
  is_timing_point         Boolean?
  group_id                String
  previous_group_id       String?
  otp_state               String?
  expected_headway        Int?
  actual_headway          Int?
  headway_time_difference Int?
  time_difference         Int?
  stop_id                 Int?
  servicepattern_id       Int
  vehiclejourney_id       Int
  expected_journeys       expected_journeys @relation(fields: [group_id], references: [group_id])
  SiriVMPositions         SiriVMPositions? @relation(fields: [group_id, actual_departure_time], references: [group_id, recorded_at_time])
  @@unique([group_id, actual_departure_time])
}

view naptan_adminarea_with_shape{
  id Int @id @default(1)
  name String
  atco_code String
  st_asgeojson String
  noc_adminareas noc_adminarea[]
}

view noc_adminarea {
  national_operator_code String
  adminarea_id Int

  admin_area    naptan_adminarea_with_shape @relation(fields: [adminarea_id], references: [id])
  operator      all_operators     @relation(fields: [national_operator_code], references: [operatorref])

  @@id([national_operator_code, adminarea_id])
}

model OperatorAdminArea {
  operator_admin_area_id Int    @id @default(1)
  operator_noc           String
  admin_area_id          Int
}

model expected_operators {
  date_of_journey      DateTime 
  operator_noc         String
  operator_name        String
  expected_services    expected_services[]
  @@id([operator_noc, date_of_journey]) 
}

model expected_services {
  line_name             String
  noc_and_line_and_servicecode          String
  service_name          String
  date_of_journey       DateTime
  operator_noc          String
  expected_operator     expected_operators @relation(fields: [operator_noc, date_of_journey], references: [operator_noc, date_of_journey])
  expected_journeys     expected_journeys[]       
  @@id([noc_and_line_and_servicecode, date_of_journey])
}

model expected_journeys {
  group_id                    String            @unique
  operator_noc                String
  line_name                   String
  journey_pattern_description String
  journey_code                String
  date_of_journey             DateTime
  day_of_week                 Int
  noc_and_line_and_servicecode                  String
  stop_count                  Int
  vehicle_journey_id          Int               
  expected_journey_start      DateTime          @db.Timetz()      
  expected_service            expected_services  @relation(fields: [noc_and_line_and_servicecode, date_of_journey], references: [noc_and_line_and_servicecode, date_of_journey])
  timetable                   Timetable[]
  vehicle_journey             transmodel_vehiclejourney @relation(fields: [vehicle_journey_id], references: [id])
  @@id([noc_and_line_and_servicecode, journey_code, date_of_journey])
}

model transmodel_vehiclejourney {
  id            Int      @id @default(1)
  start_time    DateTime @db.Time(6)
  stops         transmodel_servicepatternstop[]
  expected_journeys expected_journeys[]
}

model transmodel_servicepatternstop {
  id                  Int      @id @default(1)
  sequence_number     Int
  naptan_stop_id      Int
  is_timing_point     Boolean
  vehicle_journey_id  Int
  atco_code           String
  departure_time      DateTime @db.Time(6)
  txc_common_name     String?
  journey             transmodel_vehiclejourney @relation(fields: [vehicle_journey_id], references: [id])
  naptan_stop         naptan_stoppoint_latlong  @relation(fields: [naptan_stop_id], references: [id])
}

view naptan_stoppoint_latlong {
  id                  Int      @id @default(1)
  common_name         String
  latitude            Decimal
  longitude           Decimal
  locality_id         String
  atco_code           String
  sp_stops            transmodel_servicepatternstop[]
  locality            naptan_locality @relation(fields: [locality_id], references: [gazetteer_id])
}

model naptan_locality {
  gazetteer_id            String      @unique
  name                    String
  admin_area_id           Int
  admin_area              naptan_adminarea @relation(fields: [admin_area_id], references: [id])
  timetable_summary_stops timetable_summary_stops[]
  stops                   naptan_stoppoint_latlong[]
}

model naptan_adminarea {
  id                  Int      @id @default(1)
  name                String
  locality            naptan_locality[]
}

model timetable_threshold_summary {
  threshold_id                        Int      @id @default(1)
  operator_noc                        String
	line_name                           String
	noc_and_line_and_servicecode        String
	service_name                        String
	date_of_journey                     DateTime
	is_timing_point                     Boolean
	time_diff_minutes                   Float
	otp_count                           Int
  admin_area_id                       Int
}

model timetable_summary_operator_admin {
  timetable_id                  Int   @id @default(1)
	operator_noc                  String
	date_of_journey               DateTime
	day_of_week                   Int
	departure_hour                DateTime? @db.Time(6)
	is_timing_point               Boolean
	on_time_count                 Int
	early_count                   Int
	late_count                    Int
	completed                     Int
	scheduled                     Int
	max_late                      Int
	max_early                     Int
  avg_time_difference           Int
  admin_areas                   Int[]
}

model timetable_summary_service_admin {
  timetable_id    Int   @id @default(1)
  line_name String
  noc_and_line_and_servicecode String
  service_name String
	operator_noc String
	date_of_journey DateTime
	day_of_week Int
	departure_hour DateTime? @db.Time(6)
	is_timing_point Boolean
	on_time_count Int
	early_count Int
	late_count Int
	completed Int
	scheduled Int
	max_late Int
	max_early Int
  avg_time_difference Int
  admin_areas                 Int[]
}

model performance_statistics {
  operator_noc            String
  line_name               String
  noc_and_line            String
  service_name            String
  is_timing_point         Boolean
  date_period_start       DateTime
  date_period_end         DateTime
  period_type             String
  on_time_count           Int
  early_count             Int
  late_count              Int
  total_count             Int
  on_time_percentage      Decimal
  trend_period_start      DateTime?
  trend_period_end        DateTime?
  trend_on_time_count     Int?
  trend_early_count       Int?
  trend_late_count        Int?
  trend_total_count       Int?
  trend_percentage        Decimal?

  @@unique([operator_noc, noc_and_line, date_period_start, period_type, service_name])
}