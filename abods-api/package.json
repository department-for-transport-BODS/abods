{
  "name": "abods-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "sam:build": "sam build",
    "sam:start": "sam local start-api --port 3000",
    "start:local": "serverless offline",
    "start": "npm run build && node ./dist/localServer.js",
    "start:dev": "concurrently \"npm run watch\" \"node ./dist/localServer.js\"",
    "start:sam": "npm run sam:build && npm run sam:start",
    "generate-secrets": "node --loader ts-node/esm src/scripts/generate-api-token.ts",
    "prepare": "(npm run prisma:generate);",
    "lint": "eslint --fix --cache --quiet .",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@apollo/server": "^4.10.2",
    "@as-integrations/aws-lambda": "^3.1.0",
    "@aws-sdk/client-secrets-manager": "^3.682.0",
    "@aws-sdk/credential-providers": "^3.577.0",
    "@aws-sdk/rds-signer": "^3.577.0",
    "@codegenie/serverless-express": "^4.14.1",
    "@graphql-tools/graphql-file-loader": "^8.0.1",
    "@graphql-tools/load": "^8.0.2",
    "@prisma/client": "^5.22.0",
    "@types/jest": "^29.5.12",
    "apollo-server-plugin-http-headers": "^0.1.4",
    "argon2": "^0.40.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "dayjs-plugin-utc": "^0.1.2",
    "express-session": "^1.18.0",
    "graphql": "^16.8.1",
    "graphql-scalars": "^1.24.0",
    "graphql-tag": "^2.12.6",
    "haversine-distance": "^1.2.3",
    "ioredis": "^5.4.1",
    "jest-mock-extended": "^3.0.7",
    "kysely": "^0.27.4",
    "node-postgres": "^0.6.2",
    "pg": "^8.13.1",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "redis": "^4.6.13",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.12.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "prisma-kysely": "^1.8.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.9.0",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
