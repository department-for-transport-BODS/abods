    "@graphql-tools/load": "^8.0.2",
    "@prisma/client": "^5.14.0",
    "@types/jest": "^29.5.12",
    "apollo-server-plugin-http-headers": "^0.1.4",
    "argon2": "^0.40.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
