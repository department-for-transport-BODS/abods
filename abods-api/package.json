{
  "name": "abods-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "sam:build": "sam build",
    "sam:start": "sam local start-api --port 3000",
    "start:local": "serverless offline",
    "start": "npm run build && node ./dist/localServer.js",
    "start:dev": "concurrently \"npm run watch\" \"node ./dist/localServer.js\"",
    "start:sam": "npm run sam:build && npm run sam:start",
    "generate-secrets": "node --loader ts-node/esm src/scripts/generate-api-token.ts",
    "lint": "eslint --ignore-pattern src/kysely.ts --fix --cache --quiet .",
    "lint:check": "eslint --ignore-pattern src/kysely.ts ."
  },
  "dependencies": {
    "@apollo/server": "^4.10.2",
    "@as-integrations/aws-lambda": "^3.1.0",
    "@aws-sdk/client-quicksight": "^3.744.0",
    "@aws-sdk/client-secrets-manager": "^3.682.0",
    "@aws-sdk/client-sts": "^3.744.0",
    "@aws-sdk/credential-providers": "^3.577.0",
    "@aws-sdk/rds-signer": "^3.577.0",
    "@codegenie/serverless-express": "^4.14.1",
    "argon2": "^0.40.1",
    "cors": "^2.8.5",
    "datadog-lambda-js": "^9.119.0",
    "dayjs": "^1.11.11",
    "dayjs-plugin-utc": "^0.1.2",
    "graphql": "^16.8.1",
    "graphql-scalars": "^1.23.0",
    "graphql-tag": "^2.12.6",
    "haversine-distance": "^1.2.3",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@graphql-eslint/eslint-plugin": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.13",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.9.0",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
