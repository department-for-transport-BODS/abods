{
  "name": "abods-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "sam:build": "sam build",
    "sam:start": "sam local start-api --port 3000",
    "start": "npm run build && node ./dist/localServer.js",
