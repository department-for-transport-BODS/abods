{
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "fmt": "prettier -w .",
    "fmt:check": "prettier --check .",
    "postinstall": "(cd abods-api && npm install) && (cd frontend && npm install)",
    "db": "./scripts/db_connect.sh sandbox",
    "start:api": "(cd abods-api && npm run start:local)",
    "start:app": "(cd frontend && npm start)",
    "start": "concurrently --kill-others \"npm run db\" \"npm run start:api\" \"npm run start:app\"",
    "pre-push": "(npm run lint:check) && (npm run type-check)",
    "lint": "(cd abods-api && npm run lint) && (cd frontend && npm run lint)",
    "lint:check": "(cd abods-api && npm run lint:check) && (cd frontend && npm run lint:check)",
    "prepare": "(npm run codegen) && husky",
    "type-check": "(cd abods-api && npm run type-check) && (cd frontend && npm run type-check)",
    "test:ci": "(cd abods-api && npm run test) && (cd frontend && npm run test:ci)",
    "test:e2e": "playwright test --ignore-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "coverage:e2e-report": "open coverage/e2e/index.html || xdg-open coverage/e2e/index.html"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-apollo-angular": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-codegen/typescript-resolvers": "^5.1.0",
    "@playwright/test": "^1.49.0",
    "@types/express": "^5.0.3",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^22.10.5",
    "c8": "^10.1.3",
    "concurrently": "^9.2.1",
    "graphql-scalars": "^1.25.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "lint-staged": "^16.1.6",
    "node-mocks-http": "^1.17.2",
    "nyc": "^17.1.0",
    "prettier": "3.2.5",
    "source-map": "^0.7.6",
    "typescript": "^5.9.3",
    "v8-to-istanbul": "^9.3.0"
  },
  "lint-staged": {
    "**/*": "prettier --write"
  },
  "dependencies": {
    "jest": "^30.2.0"
  }
}
